# Secrets
.env
.env.local

# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
*.egg-info/
build/
dist/

# KernelAgent runtime artifacts
triton_kernel_logs/
.fuse/
.optimize/

# Generated kernels from one-off runs. The pattern is unanchored, so it also
# matches every benchmark case's kernel.py; those are checked-in fixtures.
kernel.py
!benchmark_fn_fp/**/kernel.py

# Local measurement scratch: the old pure-PyTorch CPU cases, superseded by
# benchmark_fn_fp/triton/ and kept out of the tree deliberately.
# The 16 first-round cases at this level were pure-PyTorch CPU operators, and
# verifying a PyTorch call is not the task -- real verification is of a GPU
# kernel. They were superseded by benchmark_fn_fp/triton/ and deleted; two of
# their names (fn4_gqa_head_mapping_homogeneous) collided with the Triton case
# that replaced them, which is how they caused confusion while sitting unused.
# batch0_cpu_synthetic_fn_fp.py still regenerates them if they are ever wanted.
benchmark_fn_fp/fn[0-9]_*/
benchmark_fn_fp/fp[0-9]_*/
element_add_kernel.py
final_test.py

# Dataset of generated kernel artifacts is committed as a fixture so anyone
# cloning the repo can immediately run `kv-agentic-run` without rebuilding.
# Uncomment the line below if you want to ignore it instead.
# dataset/

# Agentic verifier run artifacts (run.json, transcript.md, verdict.json, etc.)
# are generated output, not source -- never committed.
dataset/**/agentic_runs/
