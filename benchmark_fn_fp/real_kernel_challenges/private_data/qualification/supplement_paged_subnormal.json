  "model_api_calls": 0,
  "complete_audit_code": "\"\"\"Post-registration targeted hardware audit; no evaluation-model calls.\"\"\"\nimport hashlib\nimport json\nfrom pathlib import Path\nimport modal\n\nPUBLIC = Path('/Users/tanxinhao/projects/KernelVerification/benchmark_fn_fp/triton_eval_cases/case_115')\nDEST = Path('/Users/tanxinhao/projects/KernelVerification/benchmark_fn_fp/real_kernel_challenges/private_data/qualification/supplement_paged_subnormal.json')\napp = modal.App('kv-paged-subnormal-source-audit')\nimage = modal.Image.debian_slim(python_version='3.11').pip_install('torch==2.8.0', 'triton==3.4.0', 'numpy==1.26.4')\nif modal.is_local():\n    image = image.add_local_dir(str(PUBLIC), '/root/case_115')\n\n@app.function(image=image, gpu='T4', timeout=900)\ndef audit():\n    import importlib.util\n    import math\n    import platform\n    import torch\n    import triton\n    import numpy as np\n    source = Path('/root/case_115/kernel.py')\n    spec = importlib.util.spec_from_file_location('audit_candidate', source)\n    kernel = importlib.util.module_from_spec(spec)\n    spec.loader.exec_module(kernel)\n    # Fixed supplemental plan generated from the source corner, not from model outputs.\n    configs = []\n    for d in (32, 64, 128):\n        for group in (1, 2, 4, 8):\n            for qsign, ksign, vpattern in ((1., -1., 'positive'), (-1., 1., 'negative'), (1., 1., 'alternating_dimensions')):\n                configs.append(dict(d=d, group=group, qt=2, length=129, window=1,\n                                    qvalue=qsign, kvalue=ksign, vpattern=vpattern, kind='single_live_key'))\n    for qvalue in (1., .99951171875, .998046875, .9921875):\n        for kval in (-1., -.99951171875):\n            configs.append(dict(d=128, group=2, qt=4, length=130, window=2,\n                                qvalue=qvalue, kvalue=-1., k_second=kval,\n                                vpattern='alternating_tokens', kind='two_live_keys_cancellation'))\n    configs.append(dict(d=128, group=1, qt=16, length=143, window=1,\n                        qvalue=1., kvalue=-1., vpattern='positive', kind='query_tile_end'))\n    records = []\n    for cfg in configs:\n        d, group, qt, length, window = [cfg[key] for key in ('d','group','qt','length','window')]\n        page = 16\n        cap = (length+page-1)//page\n        pages = cap+2\n        q = torch.full((1,qt,group,d), cfg['qvalue'], dtype=torch.float16)\n        k = torch.full((pages,page,1,d), float('nan'), dtype=torch.float16)\n        v = torch.full_like(k, float('nan'))\n        table = torch.arange(cap,0,-1,dtype=torch.int32).reshape(1,cap).contiguous()\n        lo = max(0,length-qt-window+1)\n        for logical in range(lo,length):\n            phys = int(table[0,logical//page])\n            kval = cfg.get('k_second',cfg['kvalue']) if logical%2 else cfg['kvalue']\n            k[phys,logical%page].fill_(kval)\n            value = torch.ones((1,d),dtype=torch.float16)\n            if cfg['vpattern']=='negative':value.neg_()\n            elif cfg['vpattern']=='alternating_dimensions':value[:,::2] = -1\n            elif cfg['vpattern']=='alternating_tokens':value.fill_(1. if logical%2 else -1.)\n            v[phys,logical%page] = value\n        lengths = torch.tensor([length],dtype=torch.int32)\n        cpu = (q,k,v,table,lengths,window)\n        kernel.validate_inputs(*cpu,require_cuda=False)\n        expected = kernel.reference(*cpu)\n        # Separate NumPy FP64 direct gather reference.\n        independent = np.empty(q.shape,dtype=np.float64)\n        qn,kn,vn,tn=q.numpy(),k.numpy(),v.numpy(),table.numpy()\n        for row in range(qt):\n            end=length-qt+row+1\n            pos=np.arange(max(0,end-window),end)\n            ids=tn[0,pos//page]\n            keys=kn[ids,pos%page,0].astype(np.float64)\n            vals=vn[ids,pos%page,0].astype(np.float64)\n            for head in range(group):\n                scores=(keys*qn[0,row,head].astype(np.float64)).sum(1)/math.sqrt(d)\n                probs=np.exp(scores-scores.max());probs/=probs.sum()\n                independent[0,row,head]=(probs[:,None]*vals).sum(0)\n        reference_gap=float(np.max(np.abs(independent-expected.numpy())))\n        assert reference_gap<1e-11\n        gpu=tuple(t.cuda() for t in cpu[:-1])+(window,)\n        snapshots=[t.clone() for t in gpu[:-1]]\n        out=kernel.run(*gpu)\n        torch.cuda.synchronize()\n        actual=out.cpu().double()\n        ratio=float(((actual-expected).abs()/(.003+.003*expected.abs())).max())\n        finite=bool(torch.isfinite(actual).all())\n        preserved=all(torch.equal(a.view(torch.uint8),b.view(torch.uint8)) for a,b in zip(gpu[:-1],snapshots))\n        passed=finite and ratio<=1 and preserved\n        last_row=qt-1\n        result={'config':cfg,'passed':passed,'finite':finite,'max_error_ratio':ratio if finite else None,\n                'reference_gap':reference_gap,'inputs_preserved':preserved,\n                'last_query_output_first_element':float(actual[0,last_row,0,0]) if finite else str(float(actual[0,last_row,0,0])),\n                'last_query_expected_first_element':float(expected[0,last_row,0,0]),\n                'unnormalized_p_if_running_max_zero':math.exp(cfg['qvalue']*cfg['kvalue']*math.sqrt(d))}\n        records.append(result)\n        if len(records) in (1,25,36) or not passed:\n            print(json.dumps(result),flush=True)\n    return {'case':'case_115','audit_kind':'Supplemental numerical audit prompted by source inspection after qualification freeze; not preregistered coverage, not a model-selected rerun.',\n            'source_sha256':hashlib.sha256(source.read_bytes()).hexdigest(),\n            'problem_sha256':hashlib.sha256(Path('/root/case_115/problem.txt').read_bytes()).hexdigest(),\n            'environment':{'gpu':torch.cuda.get_device_name(),'compute_capability':list(torch.cuda.get_device_capability()),\n                           'torch':torch.__version__,'triton':triton.__version__,'numpy':np.__version__,'python':platform.python_version()},\n            'total_runs':len(records),'failing_runs':sum(not row['passed'] for row in records),\n            'max_error_ratio':max(row['max_error_ratio'] for row in records if row['max_error_ratio'] is not None),\n            'records':records,'model_api_calls':0}\n\n@app.local_entrypoint()\ndef main():\n    if DEST.exists():\n        raise RuntimeError('Refusing to overwrite supplemental audit evidence')\n    before=hashlib.sha256((PUBLIC/'kernel.py').read_bytes()).hexdigest()\n    result=audit.remote()\n    after=hashlib.sha256((PUBLIC/'kernel.py').read_bytes()).hexdigest()\n    assert before==after==result['source_sha256']\n    result['complete_audit_code']=Path(__file__).read_text()\n    result['public_files_modified']=False\n    DEST.write_text(json.dumps(result,indent=2,ensure_ascii=False)+'\\n')\n    print(json.dumps({k:result[k] for k in ('case','total_runs','failing_runs','max_error_ratio','source_sha256')}),flush=True)\n    print('Evidence saved:',str(DEST),flush=True)\n",
