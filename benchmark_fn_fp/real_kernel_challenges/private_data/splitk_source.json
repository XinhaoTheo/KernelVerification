  "adaptations": [
    "Independent small contiguous FP16 GEMM implementation for NVIDIA T4; retain FP32 tensor-core accumulation, separate scratch per partition, and final FP32 reduction plus bias.",
    "Fix tile sizes (16,16,32) and partition count to remove autotuning; reduce shape/value bounds for a low-cost pilot.",
    "Remove ragged layouts, quantized formats, grouped routing, custom activations and distributed paths. This is mechanism reuse, not a verbatim production-kernel benchmark.",
    "Add identical executable public input validator, FP64 full-matmul reference, contract, example generator and license to both implementations."
  ],
  "synthetic_mutation": {
    "case_116": "work_dtype = a.dtype if split_k > 1 else torch.float32",
    "case_117": "work_dtype = torch.float32",
    "location": "run(), allocation of the split-K partial-result buffer",
    "effect": "Finite partial sums are rounded to FP16 before FP32 final reduction; cancellation can expose lost low bits. No overflow is involved."
  },
  "contract_fixed_before_witness_search": {
    "shapes": "1<=M,N<=64;1<=K<=512",
    "inputs": "finite FP16 A/B with magnitude<=.5; FP32 bias with magnitude<=1; ordinary materialized tensors",
    "partition": "split_k in {1,2,4,8}, including empty partitions and nondivisible K",
    "tolerance": {
      "atol": 0.01,
      "rtol": 0.001
    },
    "objective": "all legal inputs; generator is only an example"
  },
  "numerical_argument": {
    "exact_partial_bound": "K*.5*.5<=128; every exact partial and final dot sum is finite well below FP16 overflow.",
    "fp32_bound": "FP16 products are exactly representable in FP32, including nonzero FP16 subnormal products. Conservatively allow a full FP32 ulp per accumulation (u=2^-23, allowing truncation): gamma_512*128 <0.007813; plus gamma_8*128 <0.000123 and one FP32 bias rounding <0.000016 gives <0.007952, below atol0.01. This is deliberately looser than the usual round-to-nearest bound.",
    "subnormal": "FP16 subnormal products are >=2^-48 when nonzero, normal in FP32. Even complete loss of every subnormal FP16 operand contribution is bounded by512*2^-14*.5=0.015625, so subnormal acceptance additionally relies on standard FP16 tensor-core input semantics; independent T4 tests cover smallest and largest FP16 subnormals. FP32 bias subnormal loss is negligible relative to0.01.",
    "assumptions": "Standard T4 FP16 tensor-core multiplication with FP32 accumulation as exposed by Triton 3.4; no unsafe compiler precision options. GPU verification required, not asserted from CPU emulation.",
    "limitation": "Reviewed floating-point argument plus finite independent qualification, not machine-checked universal proof."
  },
