# Copy to .env and fill in. .env is gitignored.
# Two separate programs live here and read different variables.

# === Verifier (verifier/) — the benchmark's solo / debate arms ===
# Everything it reads is prefixed AGENTIC_.
AGENTIC_PROVIDER=anthropic       # which API it calls, and which key below pays:
                                 # anthropic | openai | chatgpt | openrouter
# AGENTIC_MODEL=                 # leave unset = each provider uses its own default
AGENTIC_MAX_ROUNDS=4             # debate rounds (code default is 1)
AGENTIC_LLM_TIMEOUT_SECONDS=600  # per-call timeout

# === Generator (KernelAgent/) — unrelated to the verifier ===
OPENAI_MODEL=claude-sonnet-4-6   # named OPENAI_ upstream, but takes any model name
NUM_KERNEL_SEEDS=4               # parallel workers per problem
MAX_REFINEMENT_ROUNDS=10         # retries per worker

# === API keys (shared by both) ===
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...
